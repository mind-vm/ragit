# Copy to .env and adjust. `make up` and the example binaries both read it.
#
# The EdenAI key is NOT in here — it lives in ~/.config/envs and is exported
# into the shell, so no key is ever written into this repo. Export the one
# variable; do NOT source the file, which would also bring its DATABASE_URL:
#
#   export EDENAI_API_KEY=$(grep '^EDENAI_API_KEY=' ~/.config/envs/valiro-go.env | cut -d= -f2-)

# Admin connection. Bootstrap migrates and creates roles as this; the examples
# themselves connect as DEMO_APP_ROLE below.
DATABASE_URL=postgres://postgres:postgres@localhost:5455/ragit_examples?sslmode=disable

# The unprivileged role the examples connect as. NOSUPERUSER + NOBYPASSRLS, so
# ragit's row-level security policies actually apply to it.
DEMO_APP_ROLE=ragit_demo
DEMO_APP_PASSWORD=ragit_demo_pw

XBERG_URL=http://localhost:8234

MINIO_ENDPOINT=localhost:9200
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ragit-examples

# Embedding. Defaults match embed.DefaultBaseURL / DefaultModel / DefaultDimension.
# EDENAI_API_KEY comes from the environment, never from this file.
EDENAI_BASE_URL=https://api.eu.edenai.run/v3
EDENAI_EMBEDDING_MODEL=google/gemini-embedding-001
RAG_EMBEDDING_DIM=1536
